DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SYNC_GLOBAL_COMMANDS=false
DISCORD_RESPOND_TO_MENTIONS=true
DISCORD_MESSAGE_CONTENT_INTENT=false

DATABASE_URL=sqlite+aiosqlite:///./data/comradbot.db
ALEMBIC_CONFIG_FILE=./alembic.ini
ALEMBIC_DIRECTORY=./alembic

AI_PROVIDER=auto
TTS_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Required to enable ElevenLabs TTS. Use the ID of an official premade voice.
ELEVENLABS_TTS_VOICE_ID=

DATA_DIRECTORY=./data
SOUNDS_DIRECTORY=./data/sounds
HEALTHCHECK_HEARTBEAT_FILE=./data/.heartbeat

DEFAULT_VOLUME=0.5
MAX_QUEUE_SIZE=100
MAX_PLAYLISTS_PER_GUILD=25
MAX_PLAYLIST_TRACKS=100
MAX_SOUND_FILE_SIZE_MB=10
MAX_SOUND_DURATION_SECONDS=30
MAX_SOUNDS_PER_GUILD=100
MAX_SOUND_STORAGE_MB_PER_GUILD=500
MAX_SOUND_ARCHIVE_SIZE_MB=100
DEFAULT_AI_CONVERSATION_SCOPE=channel
DEFAULT_AI_RETENTION_DAYS=30
DEFAULT_AI_DAILY_REQUEST_BUDGET=100
MAX_AI_CONTEXT_MESSAGES=30
MAX_AI_RESPONSE_CHARACTERS=1800
MAX_AI_DISCOVERY_ITEMS=40
MAX_TTS_FILE_SIZE_MB=10
MAX_TRANSCRIPTION_FILE_SIZE_MB=20
MAX_TRANSCRIPTION_DURATION_SECONDS=300
MAX_TRANSCRIPTION_CHARACTERS=12000
AUDIO_IDLE_TIMEOUT_SECONDS=300
AI_USER_REQUESTS_PER_MINUTE=3
AI_GUILD_REQUESTS_PER_MINUTE=15
AI_COOLDOWN_SECONDS=5
AI_MAX_PROMPT_CHARACTERS=4000
AI_TIMEOUT_SECONDS=45
MUSIC_RESOLVE_TIMEOUT_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=15
HEALTHCHECK_MAX_AGE_SECONDS=45

# Override the default persona. Use \n for newlines and \" for quotes inside this value.
# Leave empty to use COMRADBOT_PERSONA from the application.
CUSTOM_COMRADBOT_PERSONA=""

LOG_LEVEL=INFO
